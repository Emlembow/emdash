---
interface Props {
	title: string;
	excerpt?: string;
	href: string;
	publishedAt?: Date | null;
}

const { title, excerpt, href, publishedAt } = Astro.props;

const dateStr = publishedAt
	? publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
	: null;
---

<article class="post-card">
	<a href={href} class="post-link">
		<h3 class="post-title">{title}</h3>
		{excerpt && <p class="post-excerpt">{excerpt}</p>}
		{dateStr && <time class="post-date">{dateStr}</time>}
	</a>
</article>

<style>
	.post-card {
		border-bottom: 1px solid var(--border-primary);
	}

	.post-card:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		padding: 1.25rem 0;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.post-link:hover .post-title {
		color: var(--accent-hover);
	}

	.post-title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.0125em;
		color: var(--text-primary);
		transition: color 150ms ease;
	}

	.post-excerpt {
		font-family: var(--font-body);
		font-size: 1.08rem;
		color: var(--text-secondary);
		margin-top: 0.5rem;
		line-height: 1.5;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.post-date {
		display: block;
		font-size: 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		margin-top: 0.5rem;
		letter-spacing: -0.01em;
	}
</style>
