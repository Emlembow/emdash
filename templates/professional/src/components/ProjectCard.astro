---
import { Image, PortableText } from "emdash/ui";
import type { PortableTextBlock } from "emdash";

interface Props {
	title: string;
	summary?: string;
	content?: PortableTextBlock[];
	image?: { src?: string; alt?: string };
	url?: string;
	githubUrl?: string;
}

const { title, summary, image, url, githubUrl } = Astro.props;
const linkHref = url || githubUrl || "#";
const isExternal = linkHref.startsWith("http");
---

<article class="project-item">
	{image?.src && (
		<div class="project-image">
			<Image image={image} />
		</div>
	)}
	<div class="project-body">
		<h3 class="project-title">
			<a href={linkHref} class="project-link" target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
				{title}
				<svg class="link-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
			</a>
		</h3>
		{summary && <p class="project-summary">{summary}</p>}
		<div class="project-links">
			{url && (
				<a href={url} target="_blank" rel="noopener noreferrer" class="project-ext-link">
					Visit
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			)}
			{githubUrl && (
				<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="project-ext-link">
					GitHub
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			)}
		</div>
	</div>
</article>

<style>
	.project-item {
		display: flex;
		gap: 1.5rem;
		padding: 1.5rem;
		background: var(--surface-400);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		transition: box-shadow 200ms ease;
	}

	.project-item:hover {
		box-shadow: var(--shadow-ambient);
	}

	.project-image {
		flex-shrink: 0;
		width: 160px;
		overflow: hidden;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-primary);
	}

	.project-image :global(img) {
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.project-body {
		flex: 1;
		min-width: 0;
	}

	.project-title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.0125em;
	}

	.project-link {
		color: var(--text-primary);
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		transition: color 150ms ease;
	}

	.project-link:hover {
		color: var(--accent-hover);
	}

	.link-icon {
		margin-left: 0.375rem;
		flex-shrink: 0;
		transition: transform 200ms ease;
	}

	.project-link:hover .link-icon {
		transform: translate(2px, -2px);
	}

	.project-summary {
		font-family: var(--font-body);
		font-size: 1.08rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-top: 0.5rem;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.project-links {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.875rem;
	}

	.project-ext-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 3px 8px;
		background: var(--surface-300);
		border-radius: var(--radius-pill);
		transition: color 150ms ease, background 150ms ease;
		letter-spacing: -0.01em;
	}

	.project-ext-link:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}

	@media (max-width: 640px) {
		.project-item {
			flex-direction: column;
			gap: 1rem;
		}

		.project-image {
			width: 100%;
			max-height: 180px;
		}
	}
</style>
