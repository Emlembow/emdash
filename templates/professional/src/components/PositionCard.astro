---
import { PortableText } from "emdash/ui";
import type { PortableTextBlock } from "emdash";

interface Props {
	title: string;
	company: string;
	location?: string;
	startDate?: string;
	endDate?: string;
	technologies?: string[];
	content?: PortableTextBlock[];
	url?: string;
}

const { title, company, location, startDate, endDate, technologies, content, url } = Astro.props;

function formatYear(date?: string): string {
	if (!date) return "";
	return date.split("-")[0] ?? "";
}

const start = formatYear(startDate);
const end = endDate ? formatYear(endDate) : "Present";
const dateRange = start ? `${start} — ${end}` : "";
---

<article class="experience-item">
	<div class="experience-header">
		<h3 class="role-title">
			{url ? (
				<a href={url} target="_blank" rel="noopener noreferrer" class="role-link">
					{title} · {company}
					<svg class="link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			) : (
				<span>{title} · {company}</span>
			)}
		</h3>
		<div class="role-meta">
			{dateRange && <time class="role-dates">{dateRange}</time>}
			{location && <span class="role-location">{location}</span>}
		</div>
	</div>

	{content && content.length > 0 && (
		<div class="role-content">
			<PortableText value={content} />
		</div>
	)}

	{technologies && technologies.length > 0 && (
		<div class="tech-tags">
			{technologies.map((tech: string) => (
				<span class="tech-tag">{tech}</span>
			))}
		</div>
	)}
</article>

<style>
	.experience-item {
		padding: 1.5rem;
		background: var(--surface-400);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		transition: box-shadow 200ms ease;
		position: relative;
	}

	.experience-item:hover {
		box-shadow: var(--shadow-ambient);
	}

	.experience-header {
		margin-bottom: 0.75rem;
	}

	.role-title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.0125em;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
	}

	.role-link {
		color: var(--text-primary);
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		transition: color 150ms ease;
	}

	.role-link:hover {
		color: var(--accent-hover);
	}

	.link-icon {
		display: inline-block;
		width: 14px;
		height: 14px;
		margin-left: 0.375rem;
		flex-shrink: 0;
		transition: transform 200ms ease;
		vertical-align: baseline;
	}

	.role-link:hover .link-icon {
		transform: translate(2px, -2px);
	}

	.role-meta {
		margin-bottom: 0.75rem;
		font-family: var(--font-mono);
	}

	.role-dates {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-right: 1rem;
		letter-spacing: -0.01em;
	}

	.role-location {
		font-size: 0.75rem;
		color: var(--text-muted);
		letter-spacing: -0.01em;
	}

	.role-content {
		font-family: var(--font-body);
		font-size: 1.08rem;
		line-height: 1.5;
		color: var(--text-secondary);
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.role-content :global(p) {
		margin-bottom: 0.75rem;
	}

	.role-content :global(p:last-child) {
		margin-bottom: 0;
	}

	.role-content :global(ul) {
		list-style-type: disc;
		list-style-position: outside;
		margin: 0.75rem 0;
		padding-left: 1.5rem;
	}

	.role-content :global(ol) {
		list-style-type: decimal;
		list-style-position: outside;
		margin: 0.75rem 0;
		padding-left: 1.5rem;
	}

	.role-content :global(li + li) {
		margin-top: 0.5rem;
	}

	.role-content :global(strong) {
		font-weight: 600;
		color: var(--text-primary);
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 1rem;
	}

	.tech-tag {
		display: inline-flex;
		align-items: center;
		padding: 3px 8px;
		font-size: 0.75rem;
		font-weight: 400;
		font-family: var(--font-mono);
		background: var(--surface-300);
		color: var(--text-muted);
		border-radius: var(--radius-pill);
		transition: color 150ms ease, background 150ms ease;
		letter-spacing: -0.01em;
	}

	.tech-tag:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}
</style>
