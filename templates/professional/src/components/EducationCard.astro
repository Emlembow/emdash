---
interface Props {
	title: string;
	institution: string;
	field?: string;
	endDate?: string;
}

const { title, institution, field, endDate } = Astro.props;
---

<div class="education-entry">
	<p class="education-degree">
		<strong>{title}</strong> — {institution}
		{endDate && <span class="education-year"> ({endDate})</span>}
	</p>
</div>

<style>
	.education-entry {
		padding: 0.375rem 0;
	}

	.education-degree {
		font-family: var(--font-body);
		font-size: 1.08rem;
		color: var(--text-secondary);
		line-height: 1.5;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.education-degree strong {
		font-weight: 500;
		color: var(--text-primary);
	}

	.education-year {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.85em;
		letter-spacing: -0.01em;
	}
</style>
