---
import { PortableText } from "emdash/ui";
import type { PortableTextBlock } from "emdash";

interface Props {
	name: string;
	role?: string;
	company?: string;
	relationship?: string;
	content?: PortableTextBlock[];
	url?: string;
}

const { name, role, company, relationship, content, url } = Astro.props;
---

<article class="reference-item">
	<div class="reference-header">
		<div class="reference-info">
			<h3 class="reference-name">{name}</h3>
			{(role || company) && (
				<div class="reference-role">
					{role}{role && company ? ", " : ""}{company}
				</div>
			)}
			{relationship && (
				<div class="reference-relationship">{relationship}</div>
			)}
		</div>
		{url && (
			<a href={url} target="_blank" rel="noopener noreferrer" class="reference-linkedin">
				LinkedIn
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
			</a>
		)}
	</div>

	{content && content.length > 0 && (
		<div class="reference-content">
			<PortableText value={content} />
		</div>
	)}
</article>

<style>
	.reference-item {
		padding: 1.5rem;
		background: var(--surface-400);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-md);
		transition: box-shadow 200ms ease;
	}

	.reference-item:hover {
		box-shadow: var(--shadow-ambient);
	}

	.reference-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1rem;
		gap: 1rem;
	}

	.reference-name {
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--text-primary);
	}

	.reference-role {
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--text-muted);
		margin-top: 0.25rem;
	}

	.reference-relationship {
		font-size: 0.75rem;
		color: var(--text-faint);
		font-family: var(--font-mono);
		margin-top: 0.25rem;
		letter-spacing: -0.01em;
	}

	.reference-linkedin {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 3px 8px;
		background: var(--surface-300);
		border-radius: var(--radius-pill);
		transition: color 150ms ease, background 150ms ease;
		flex-shrink: 0;
		letter-spacing: -0.01em;
	}

	.reference-linkedin:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}

	.reference-content {
		font-family: var(--font-body);
		font-size: 1.08rem;
		color: var(--text-secondary);
		line-height: 1.5;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.reference-content :global(p) {
		margin-bottom: 1rem;
	}

	.reference-content :global(p:last-child) {
		margin-bottom: 0;
	}

	.reference-content :global(ul) {
		list-style-type: disc;
		list-style-position: outside;
		margin: 0.75rem 0;
		padding-left: 1.5rem;
	}

	.reference-content :global(li + li) {
		margin-top: 0.5rem;
	}
</style>
