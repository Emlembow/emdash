---
interface Props {
	title: string;
	issuer?: string;
}

const { title, issuer } = Astro.props;
---

<div class="cert-entry">
	<span class="cert-name">{title}</span>
</div>

<style>
	.cert-entry {
		padding: 0.375rem 0;
		font-family: var(--font-body);
		font-size: 1.08rem;
		color: var(--text-secondary);
		line-height: 1.5;
		list-style: disc;
		display: list-item;
		margin-left: 1.25rem;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.cert-entry::marker {
		color: var(--text-faint);
	}

	.cert-entry + .cert-entry {
		margin-top: 0;
	}
</style>
