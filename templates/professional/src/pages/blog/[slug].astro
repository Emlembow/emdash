---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { x402 } = Astro.locals as { x402?: any };
if (x402) {
	const result = await x402.enforce(Astro.request);
	if (result instanceof Response) return result;
	x402.applyHeaders(result, Astro.response);
}

const { slug } = Astro.params;
const { entry, cacheHint } = await getEmDashEntry("posts", slug!);

if (!entry) {
	return Astro.redirect("/blog");
}

Astro.cache.set(cacheHint);

const dateStr = entry.data.publishedAt
	? entry.data.publishedAt.toLocaleDateString("en-US", {
			month: "long",
			day: "numeric",
			year: "numeric",
		})
	: null;
---

<Base
	title={entry.data.title ?? "Post"}
	description={entry.data.excerpt}
	type="article"
	content={{ collection: "posts", id: entry.data.id, slug: entry.data.slug }}
>
	<article class="post">
		<a href="/blog" class="back-link">&larr; Back to writing</a>
		<header class="post-header">
			<h1 class="post-title">{entry.data.title}</h1>
			{dateStr && <time class="post-date">{dateStr}</time>}
		</header>
		{entry.data.content && (
			<div class="post-content">
				<PortableText value={entry.data.content} />
			</div>
		)}
	</article>
</Base>

<style>
	.post {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		padding: 3px 8px;
		background: var(--surface-300);
		border-radius: var(--radius-pill);
		margin-bottom: 2rem;
		transition: color 150ms ease, background 150ms ease;
		letter-spacing: -0.01em;
	}

	.back-link:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}

	.post-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-primary);
	}

	.post-title {
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.post-date {
		display: block;
		font-size: 0.75rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		margin-top: 1rem;
		letter-spacing: -0.01em;
	}

	.post-content {
		font-family: var(--font-body);
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--text-secondary);
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.post-content :global(h2) {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.0125em;
		color: var(--text-primary);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.post-content :global(h3) {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--text-primary);
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.post-content :global(p) {
		margin-bottom: 1.25rem;
	}

	.post-content :global(strong) {
		font-weight: 600;
		color: var(--text-primary);
	}

	.post-content :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-color: var(--text-faint);
		text-underline-offset: 3px;
		transition: color 150ms ease;
	}

	.post-content :global(a:hover) {
		color: var(--accent-hover);
	}

	.post-content :global(blockquote) {
		border-left: 2px solid var(--accent);
		padding-left: 1.25rem;
		margin: 1.5rem 0;
		color: var(--text-muted);
		font-style: italic;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
		list-style: disc;
	}

	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.post-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: var(--surface-300);
		color: var(--text-primary);
		padding: 1px 6px;
		border-radius: 3px;
		border: 1px solid var(--border-primary);
		letter-spacing: -0.01em;
	}
</style>
