---
import { getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
const { entry, cacheHint } = await getEmDashEntry("projects", slug!);

if (!entry) {
	return new Response(null, { status: 404 });
}

Astro.cache.set(cacheHint);
---

<Base
	title={entry.data.title ?? "Project"}
	description={entry.data.summary}
	content={{ collection: "projects", id: entry.data.id, slug: entry.data.slug }}
>
	<article class="project-detail">
		<a href="/#projects" class="back-link">&larr; Back to projects</a>
		<header class="project-header">
			<h1 class="project-title">{entry.data.title}</h1>
			{entry.data.summary && <p class="project-summary">{entry.data.summary}</p>}
			<div class="project-links">
				{entry.data.url && (
					<a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="project-ext-link">
						Visit project
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
					</a>
				)}
				{entry.data.github_url && (
					<a href={entry.data.github_url} target="_blank" rel="noopener noreferrer" class="project-ext-link">
						GitHub
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
					</a>
				)}
			</div>
		</header>
		{entry.data.featured_image?.src && (
			<div class="project-image">
				<Image image={entry.data.featured_image} />
			</div>
		)}
		{entry.data.content && (
			<div class="project-content">
				<PortableText value={entry.data.content} />
			</div>
		)}
	</article>
</Base>

<style>
	.project-detail {
		position: relative;
		z-index: 1;
		max-width: 720px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.back-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		padding: 3px 8px;
		background: var(--surface-300);
		border-radius: var(--radius-pill);
		margin-bottom: 2rem;
		transition: color 150ms ease, background 150ms ease;
		letter-spacing: -0.01em;
	}

	.back-link:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}

	.project-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border-primary);
	}

	.project-title {
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.project-summary {
		font-family: var(--font-body);
		font-size: 1.2rem;
		color: var(--text-secondary);
		line-height: 1.55;
		margin-top: 0.75rem;
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.project-links {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.project-ext-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 3px 10px;
		background: var(--surface-300);
		border-radius: var(--radius-pill);
		transition: color 150ms ease, background 150ms ease;
		letter-spacing: -0.01em;
	}

	.project-ext-link:hover {
		color: var(--accent-hover);
		background: var(--surface-500);
	}

	.project-image {
		margin-bottom: 2rem;
		overflow: hidden;
		border-radius: var(--radius-md);
		border: 1px solid var(--border-primary);
	}

	.project-content {
		font-family: var(--font-body);
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--text-secondary);
		font-feature-settings: "cswh" on, "ss01" on;
	}

	.project-content :global(p) {
		margin-bottom: 1.25rem;
	}

	.project-content :global(h2) {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 500;
		letter-spacing: -0.0125em;
		color: var(--text-primary);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.project-content :global(strong) {
		font-weight: 600;
		color: var(--text-primary);
	}
</style>
